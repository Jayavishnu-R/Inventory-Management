
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="4.0">
  <display-name>Inventory Management API</display-name>

  <welcome-file-list>
    <welcome-file>login.jsp</welcome-file>
  </welcome-file-list>


<!--  <servlet>-->
<!--    <servlet-name>ItemResource</servlet-name>-->
